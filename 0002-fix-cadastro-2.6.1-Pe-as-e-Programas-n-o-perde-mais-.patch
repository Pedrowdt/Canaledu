+    CanalLog.registrar('cadastro_rascunho_recuperado', {
+      email_original: rascunho.email,
+      exclusoesPecas: deletedPecas.length,
+      exclusoesProgramas: deletedProgramas.length,
+    }, { nivel: 'warn' });
+  }
+  scheduleSync();
+}
